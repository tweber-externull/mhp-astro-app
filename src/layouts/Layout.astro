---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { wpquery } from "../data/wordpress";

interface Props {
	title: string;
}

const { title } = Astro.props;

const data = await wpquery({
	query: `
		query AllPages {
			pages {
				nodes {
					uri
					title
					pageId
				}
			}
		}
	`,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Morgan Henley Presents specializes in booking and promoting
		the best in live music, comedy, and more at various locations around the Snoqualmie Valley"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<link
			rel="shortcut icon"
			type="image/x-icon"
			href="https://morganhenleypresents.com/img/mhp-favicon.ico"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			type="text/css"
			rel="stylesheet"
			href="../font-awesome/css/font-awesome.min.css"
		/>
	</head>
	<body>
		<Header brandName="Morgan Henley Presents" pages={data.pages.nodes} />
		<slot />
		<Footer brandName="Morgan Henley Presents" pages={data.pages.nodes} />
	</body>
</html>
<style is:global>
	:root {
		--background: rgb(30, 30, 30);
		--primary: hsl(251, 85%, 65%);
		--secondary: rgb(200, 200, 200);
		--text-light: rgb(255, 255, 255, 1);
		--text-dark: rgb(0, 0, 0);
		--accent-light: rgb(193, 228, 180);
		--accent: rgb(104, 190, 70);
		--accent-dark: rgb(40, 75, 27);
		--accent-gradient: linear-gradient(
			45deg,
			var(--accent-light) 45%,
			var(--accent)
		);
	}
	html {
		font-family: system-ui, sans-serif;
		background: var(--background);
		background-size: 224px;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	a {
		color: var(--accent-light);
	}
	p {
		margin-top: 0.5rem;
	}
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-weight: bold;
	}
	h1 {
		margin-top: 2rem;
	}
	h2 {
		margin-top: 1.75rem;
	}
	h3 {
		margin-top: 1.5rem;
	}
	h4 {
		margin-top: 1.25rem;
	}
	h5 {
		margin-top: 1rem;
	}
	h6 {
		margin-top: 0.9rem;
	}
</style>
