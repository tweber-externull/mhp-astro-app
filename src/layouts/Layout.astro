---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

// Temporary static pages until Pages content type is created in Strapi
const pages = [
	{ title: "About", uri: "/about", pageId: "1" },
	{ title: "Gallery", uri: "/gallery", pageId: "2" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Morgan Henley Presents specializes in booking and promoting
		the best in live music, comedy, and more at various locations around the Snoqualmie Valley"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<link
			rel="icon"
			type="image/x-icon"
			href="/favicon.ico"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header brandName="Morgan Henley Presents" pages={pages} />
		<slot />
		<Footer brandName="Morgan Henley Presents" pages={pages} />
	</body>
</html>
<style is:global>
	:root {
		--background: #f5f1e8;
		--surface: #fffdf7;
		--surface-tint: #e7eee1;
		--primary: #365c73;
		--secondary: #dce8d8;
		--text-light: #fffdf7;
		--text-dark: #21362b;
		--muted: #6d7d70;
		--accent-light: #d6e5a9;
		--accent: #9fbe70;
		--accent-dark: #5c814d;
		--line: rgba(54, 92, 115, 0.2);
		--accent-gradient: linear-gradient(120deg, #d6e5a9, #b7d187);
	}
	html {
		font-family: "DM Sans", sans-serif;
		background: var(--background);
		color: var(--text-dark);
	}
	body {
		margin: 0;
		background:
			radial-gradient(circle at 92% 8%, rgba(242, 200, 184, 0.35), transparent 19rem),
			radial-gradient(circle at 7% 65%, rgba(215, 230, 211, 0.55), transparent 25rem),
			var(--background);
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	a { color: inherit; }
	p {
		margin-top: 0.5rem;
	}
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: "Fraunces", Georgia, serif;
		font-weight: 500;
	}
	::selection { color: var(--text-dark); background: var(--accent-light); }
</style>
