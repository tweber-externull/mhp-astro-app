---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

// Temporary static pages until Pages content type is created in Strapi
const pages = [
	{ title: "About", uri: "/about", pageId: "1" },
	{ title: "Gallery", uri: "/gallery", pageId: "2" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Morgan Henley Presents specializes in booking and promoting
		the best in live music, comedy, and more at various locations around the Snoqualmie Valley"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<link
			rel="icon"
			type="image/x-icon"
			href="/favicon.ico"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="site-shell">
		<Header brandName="Morgan Henley Presents" pages={pages} />
		<slot />
		<Footer brandName="Morgan Henley Presents" pages={pages} />
	</body>
</html>
<style is:global>
	@import url("https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600;6..96,700&family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap");

	:root {
		--background: #1e1e1e;
		--primary: hsl(251, 85%, 65%);
		--secondary: #c8c8c8;
		--text-light: #ffffff;
		--text-dark: #111111;
		--accent-light: #c1e4b4;
		--accent: #68be46;
		--accent-dark: #284b1b;
		--accent-gradient: linear-gradient(110deg, var(--accent-light), var(--accent));
		--ink: var(--background);
		--ink-soft: #252525;
		--paper: #ffffff;
		--paper-muted: var(--secondary);
		--acid: var(--accent);
		--cobalt: var(--primary);
		--coral: var(--accent-light);
		--line: rgba(255, 255, 255, 0.18);
		--serif: "Bodoni Moda", "Iowan Old Style", "Baskerville", serif;
		--sans: "DM Sans", "Helvetica Neue", sans-serif;
		--mono: "IBM Plex Mono", "SFMono-Regular", monospace;
	}
	* { box-sizing: border-box; }
	::selection { color: var(--ink); background: var(--acid); }
	body {
		margin: 0;
		color: var(--paper);
		font-family: var(--sans);
		background:
			radial-gradient(circle at 80% 5%, rgba(121, 101, 242, 0.18), transparent 27rem),
			radial-gradient(circle at 3% 82%, rgba(104, 190, 70, 0.08), transparent 22rem),
			var(--ink);
		background-attachment: fixed;
	}
	body::before {
		position: fixed;
		inset: 0;
		z-index: 20;
		pointer-events: none;
		opacity: 0.06;
		content: "";
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
	}
	html {
		scroll-behavior: smooth;
	}
	a { color: inherit; }
	.site-shell { min-height: 100vh; }
	.eyebrow {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
</style>
