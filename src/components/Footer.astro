---
interface Props {
	brandName: string;
	pages: [Object];
}

const { brandName, pages } = Astro.props;
---

<footer class="text-white w-auto p-4 flex gap-4">
	<div class="w-2/3">
		<h4 class="text-xl font-bold">{brandName}</h4>
		<navbar class="flex flex-row gap-4">
			<li class="Home"><a href="/">Home</a></li>
			{
				pages.map((page: any) => {
					return (
						<li class={page.title}>
							<a href={page.uri}>{page.title}</a>
						</li>
					);
				})
			}
		</navbar>
	</div>
	<div class="contact w-1/3">
		<h4>Contact:</h4>
		<div class="container flex flex-row gap-4">
			<div class="max-w-48">
				<a href="tel:425-246-0695">
					<i class="fa fa-phone fa-3x mb-3 sr-contact"></i>
					<p>425-246-0695</p>
				</a>
			</div>
			<div class="max-w-48">
				<a href="mailto:example@email.com">
					<i class="fa fa-envelope-o fa-3x mb-3 sr-contact"></i>
					<p>morganhenleypresents@gmail.com</p>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		bottom: 0;
		min-height: 10rem;
		background-color: var(--primary);
	}
	li {
		list-style: none;
	}
	a:hover {
		color: var(--text-light);
	}
</style>
