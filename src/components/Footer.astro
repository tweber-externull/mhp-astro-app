---
interface Props {
	brandName: string;
	pages: [Object];
}

const { brandName, pages } = Astro.props;
---

<footer class="py-4 text-white w-full flex flex-col gap-4 text-center">
	<div class="container md:w-3/4 m-auto">
		<div class="contact w-auto">
			<h4 class="py-4">Contact:</h4>
			<div class="container flex flex-col md:flex-row gap-4 text-center">
				<div class="m-auto md:w-1/2">
					<a href="tel:425-246-0695">
						<i class="fa fa-phone fa-3x mb-3 sr-contact"></i>
						<p>425-246-0695</p>
					</a>
				</div>
				<div class="m-auto md:w-1/2">
					<a class="text-center flex flex-col" href="mailto:example@email.com">
						<i class="fa fa-envelope-o fa-3x mb-3 sr-contact"></i>
						<p class="m-auto">morganhenleypresents@gmail.com</p>
					</a>
				</div>
			</div>
		</div>
		<div class="w-auto">
			<h4 class="text-xl font-bold py-4">{brandName}</h4>
			<navbar class="flex flex-row gap-4 text-center justify-center">
				<li class="Home"><a href="/">Home</a></li>
				{
					pages.map((page: any) => {
						return (
							<li class={page.title}>
								<a href={page.uri}>{page.title}</a>
							</li>
						);
					})
				}
			</navbar>
		</div>
	</div>
</footer>

<style>
	footer {
		bottom: 0;
		min-height: 10rem;
		background-color: var(--primary);
	}
	li {
		list-style: none;
	}
	a:hover {
		color: var(--text-light);
	}
</style>
