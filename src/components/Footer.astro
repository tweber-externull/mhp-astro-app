---
interface Props { brandName: string; pages: Array<{ title: string; uri: string; pageId: string }>; }
const { brandName, pages } = Astro.props;
---
<footer>
	<div class="footer-inner">
		<div><p class="footer-kicker">Bookings / partnerships</p><a class="email" href="mailto:morganhenleypresents@gmail.com">morganhenleypresents<br />@gmail.com</a></div>
		<div class="footer-meta"><strong>{brandName}</strong><span>© {new Date().getFullYear()} / WA, USA</span><nav><a href="/">Home</a>{pages.map((page) => <a href={page.uri}>{page.title}</a>)}</nav></div>
	</div>
</footer>
<style>
	footer { margin-top: 7rem; border-top: 1px solid var(--line); background: var(--signal); color: #17120f; }
	.footer-inner { width: min(1200px, calc(100% - 3rem)); margin: auto; padding: 4rem 0 2rem; display: flex; justify-content: space-between; gap: 3rem; }
	.footer-kicker, .footer-meta span, .footer-meta nav { font: 500 .68rem/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.footer-kicker { margin: 0 0 1rem; }
	.email { color: #17120f; font: 600 clamp(1.8rem, 5vw, 4rem)/.85 var(--display); letter-spacing: -.02em; text-decoration: none; text-transform: uppercase; }
	.email:hover { text-decoration: underline; }
	.footer-meta { display: flex; flex-direction: column; align-items: end; gap: .7rem; text-align: right; }
	.footer-meta strong { font: 700 1.2rem/1 var(--display); text-transform: uppercase; }
	.footer-meta nav { display: flex; gap: 1rem; }
	.footer-meta nav a { color: #17120f; text-decoration: none; }
	.footer-meta nav a:hover { text-decoration: underline; }
	@media (max-width: 640px) { .footer-inner { width: calc(100% - 2rem); padding-top: 3rem; flex-direction: column; } .footer-meta { align-items: start; text-align: left; } }
</style>
