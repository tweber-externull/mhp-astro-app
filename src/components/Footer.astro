---
interface Props {
	brandName: string;
	pages: Array<{ title: string; uri: string; pageId: string }>;
}

const { brandName, pages } = Astro.props;
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<p class="eyebrow">Make a little noise</p>
			<h2>Bring the room<br /><em>to life.</em></h2>
		</div>
		<div class="footer-contact">
			<a href="mailto:morganhenleypresents@gmail.com">morganhenleypresents@gmail.com <span>↗</span></a>
			<a href="tel:425-246-0695">425—246—0695 <span>↗</span></a>
		</div>
		<div class="footer-bottom">
			<p>© {new Date().getFullYear()} {brandName}</p>
			<nav aria-label="Footer navigation">
				<a href="/">Home</a>
				{
					pages.map((page) => <a href={page.uri}>{page.title}</a>)
				}
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer { margin-top: 8rem; border-top: 1px solid var(--line); background: var(--ink-soft); }
	.footer-inner { max-width: 1180px; margin: auto; padding: 5rem 2rem 1.5rem; }
	.footer-top { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; }
	.footer-top h2 { margin: 0; color: var(--paper); font-family: var(--serif); font-size: clamp(3rem, 8vw, 7rem); font-weight: 500; letter-spacing: -0.07em; line-height: 0.82; }
	.footer-top h2 em { color: var(--acid); font-style: normal; }
	.footer-contact { display: flex; flex-direction: column; align-items: flex-end; gap: 0.7rem; margin-top: -2rem; }
	.footer-contact a { color: var(--paper); font-family: var(--mono); font-size: 0.75rem; text-decoration: none; }
	.footer-contact span { color: var(--acid); }
	.footer-bottom { display: flex; justify-content: space-between; gap: 1rem; margin-top: 6rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--paper-muted); font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; }
	.footer-bottom p { margin: 0; }
	.footer-bottom nav { column-gap: 2rem; }
	.footer-bottom a { text-decoration: none; }
	.footer-bottom a:hover { color: var(--acid); }
	@media (max-width: 700px) {
		.footer-inner { padding: 4rem 1.25rem 1.25rem; }
		.footer-top { display: block; }
		.footer-top h2 { margin-top: 1.5rem; }
		.footer-contact { align-items: flex-start; margin-top: 3rem; }
		.footer-bottom { display: block; margin-top: 4rem; }
		.footer-bottom nav { margin-top: 1rem; }
	}
</style>
