---
interface Props {
	brandName: string;
	pages: Array<{ title: string; uri: string; pageId: string }>;
}

const { pages } = Astro.props;
---

<header>
	<div class="header-inner">
		<a class="brand" href="/" aria-label="Morgan Henley Presents home">
			<img
				class="brand-logo"
				src="https://morganhenleypresents.com/img/logo/Morgan-Logo-bluelime_edited250w.png"
				alt="Morgan Henley Presents"
			/>
			<span class="brand-name">Morgan Henley<br />Presents</span>
		</a>
		<nav aria-label="Primary navigation">
			<a class="nav-link" href="/">Events <span>01</span></a>
			{pages.map((page) => <a class="nav-link" href={page.uri}>{page.title} <span>→</span></a>)}
		</nav>
	</div>
</header>

<style>
	header { border-bottom: 1px solid var(--line); background: rgba(17,17,15,.88); backdrop-filter: blur(14px); position: sticky; top: 0; z-index: 10; }
	.header-inner { width: min(1200px, calc(100% - 3rem)); margin: auto; min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
	.brand { display: flex; align-items: center; gap: .8rem; color: var(--paper); text-decoration: none; }
	.brand-logo { display: block; width: 4rem; height: 4rem; object-fit: contain; }
	.brand-name { font: 600 .72rem/1.05 var(--mono); letter-spacing: .04em; text-transform: uppercase; }
	nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
	.nav-link { color: var(--paper); font: 500 .72rem/1 var(--mono); letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.nav-link span { color: var(--signal); margin-left: .35rem; }
	.nav-link:hover { color: var(--signal); }
	@media (max-width: 560px) { .header-inner { width: calc(100% - 2rem); min-height: 72px; } .brand-logo { width: 3.5rem; height: 3.5rem; } .brand-name { display: none; } nav { gap: 1rem; } }
</style>
