---
import NavbarLink from "./NavbarLink.astro";

interface Props {
	brandName: string;
	pages: Array<{ title: string; uri: string; pageId: string }>;
}

const { pages } = Astro.props;
---

<header class="text-center">
	<div class="flex justify-between md:w-3/4 m-auto">
		<div class="brand py-4 md:w-1/3 flex items-center">
			<a href="#home"
				><img
					class="logo max-h-20 md:max-h-24"
					src="https://morganhenleypresents.com/img/logo/Morgan-Logo-bluelime_edited250w.png"
					alt="Morgan Henley Presents"
				/></a
			>
		</div>
		<navbar class="flex md:w-1/3 align-center flex-row justify-end">
			<NavbarLink name="Events" href="/" />
			{
				pages.map((page: any) => {
					return (
						<NavbarLink name={page.title} href={page.uri} />
					);
				})
			}
		</navbar>
	</div>
</header>

<style>
	header {
		list-style: none;
		display: flex;
		background-color: var(--secondary);
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
		margin: 0;
	}
	.brand {
		color: var(--text-dark);
		align-items: center;
	}
	.logo {
		width: 4rem;
	}
	.brand navbar {
		display: flex;
	}
	navbar > a {
		width: 100%;
		text-decoration: none;
		line-height: 1;
		color: var(--text-dark);
		opacity: 0.8;
	}
</style>
