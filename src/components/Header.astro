---
import { wpquery } from "../data/wordpress";
import NavbarLink from "./NavbarLink.astro";

interface Props {
	brandName: string;
	pages: [Object];
}

const { pages } = Astro.props;
---

<header class="flex text-center justify-between">
	<div class="brand flex justify-center flex-row">
		<a href="#home"
			><img
				class="logo"
				src="https://morganhenleypresents.com/img/logo/Morgan-Logo-bluelime_edited250w.png"
				alt="Morgan Henley Presents"
			/></a
		>
	</div>
	<navbar class="flex align-center justify-center flex-row">
		<NavbarLink name="Home" href="/" pageID="" />
		{
			pages.map((page: any) => {
				return (
					<NavbarLink name={page.title} href={page.uri} pageID={page.pageid} />
				);
			})
		}
	</navbar>
</header>

<style>
	header {
		list-style: none;
		display: flex;
		background-color: var(--secondary);
		background-image: none;
		background-size: 400%;
		background-position: 100%;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
		margin: 0;
		max-height: 5rem;
	}
	.brand {
		color: var(--text-dark);
		align-items: center;
	}
	.logo {
		width: 4rem;
	}
	.brand navbar {
		display: flex;
	}
	navbar > a {
		width: 100%;
		text-decoration: none;
		line-height: 1;
		color: var(--text-dark);
		opacity: 0.8;
	}
</style>
