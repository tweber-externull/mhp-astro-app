---
interface Props {
	brandName: string;
	pages: Array<{ title: string; uri: string; pageId: string }>;
}

const { brandName, pages } = Astro.props;
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/" aria-label={`${brandName} home`}>
			<img
				class="logo"
				src="/images/morgan-logo-square.jpg"
				alt={brandName}
				width="72"
				height="72"
				loading="eager"
				decoding="async"
			/>
			<span class="brand-name">{brandName}</span>
		</a>
		<nav aria-label="Main navigation">
			<a class="nav-link" href="/">Events</a>
			{
				pages.map((page) => (
					<a class="nav-link" href={page.uri}>{page.title}</a>
				))
			}
		</nav>
		<div class="header-note">Snoqualmie Valley<br />& beyond</div>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 3;
		border-bottom: 1px solid var(--line);
	}
	.header-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 1180px;
		min-height: 92px;
		margin: 0 auto;
		padding: 1.25rem 2rem;
	}
	.brand { display: flex; align-items: center; gap: 0.9rem; text-decoration: none; }
	.logo { display: block; width: clamp(3.5rem, 8vw, 4.5rem); height: auto; border-radius: 0.65rem; object-fit: contain; }
	.brand-name {
		max-width: 8rem;
		color: var(--paper-muted);
		font-family: var(--mono);
		font-size: 0.58rem;
		line-height: 1.25;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	nav { display: flex; gap: 1.75rem; }
	.nav-link {
		color: var(--paper);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease;
	}
	.nav-link:hover, .nav-link:focus-visible { color: var(--acid); transform: translateY(-2px); }
	.header-note {
		justify-self: end;
		color: var(--paper-muted);
		font-family: var(--mono);
		font-size: 0.58rem;
		line-height: 1.35;
		letter-spacing: 0.08em;
		text-align: right;
		text-transform: uppercase;
	}
	@media (max-width: 700px) {
		.header-inner { grid-template-columns: 1fr auto; padding: 1rem 1.25rem; }
		.header-note { display: none; }
		nav { gap: 1rem; }
		.nav-link { font-size: 0.72rem; }
		.brand-name { display: none; }
	}
</style>
