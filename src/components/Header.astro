---
import NavbarLink from "./NavbarLink.astro";

interface Props {
	brandName: string;
	pages: Array<{ title: string; uri: string; pageId: string }>;
}

const { pages } = Astro.props;
---

<header>
	<div class="header-inner">
		<a class="brand" href="/" aria-label="Morgan Henley Presents home">
			<img
				class="logo"
				src="https://morganhenleypresents.com/img/logo/Morgan-Logo-bluelime_edited250w.png"
				alt="Morgan Henley Presents"
			/>
		</a>
		<nav aria-label="Main navigation">
			<NavbarLink name="Events" href="/" />
			{
				pages.map((page: any) => {
					return (
						<NavbarLink name={page.title} href={page.uri} />
					);
				})
			}
		</nav>
	</div>
</header>

<style>
	header {
		padding: 1.25rem clamp(1.25rem, 5vw, 5rem);
	}
	.header-inner {
		max-width: 1180px;
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--line);
		padding-bottom: 1rem;
	}
	.brand {
		display: flex;
		align-items: center;
		color: var(--primary);
		text-decoration: none;
	}
	.logo {
		display: block;
		width: 4rem;
		height: auto;
		object-fit: contain;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	@media (max-width: 520px) {
		header { padding-inline: 1rem; }
		.header-inner { align-items: flex-start; }
		nav { gap: 0; }
	}
</style>
