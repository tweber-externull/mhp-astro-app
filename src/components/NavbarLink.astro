---
interface Props {
	name: string;
	href: string;
}

const { name, href } = Astro.props;
---

<li class="nav-link">
	<a href={href}>{name}</a>
</li>
<style>
	.nav-link {
		list-style: none;
		display: block;
	}
	.nav-link > a {
		display: block;
		text-decoration: none;
		padding: 0.6rem 0.8rem;
		border-radius: 99px;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 600;
		transition: color 180ms ease, background 180ms ease;
	}
	.nav-link:is(:hover, :focus-within) > a {
		color: var(--primary);
		background: var(--secondary);
	}
</style>
