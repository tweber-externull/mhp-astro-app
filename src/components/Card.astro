---
import { getMonthAndDate, getWeekdayName } from "../utils/date";

interface Props {
	date: string;
	venueName: string;
	eventTitle: string;
	city: string;
	state: string;
	ticketLink: string;
	venueWebsite: string;
}

const {
	date,
	venueName,
	city,
	state,
	ticketLink,
	venueWebsite,
	eventTitle,
} = Astro.props;

---

<li class="event-card">
	<div class="date-container">
		<p class="event-day">{getWeekdayName(date)}</p>
		<h2 class="event-date">{getMonthAndDate(date)}</h2>
	</div>
	<div class="event-details">
		<p class="event-type">Live event</p>
		<h2 class="event-title">{eventTitle}</h2>
		<h4 class="event-venue">{venueName}</h4>
		<p class="event-city-state">{city}, {state}</p>
	</div>
	<div class="event-actions">
		{ticketLink && <a class="event-ticket-link" href={ticketLink}>Tickets <span>↗</span></a>}
		{venueWebsite && <a class="event-venue-website" href={venueWebsite}>Venue <span>↗</span></a>}
	</div>
</li>
<style>
	.event-card {
		list-style: none;
		display: grid;
		grid-template-columns: 7.5rem 1fr auto;
		align-items: center;
		gap: 1.75rem;
		max-width: 800px;
		margin: 0 auto 0.9rem;
		border: 1px solid var(--line);
		border-radius: 1.1rem;
		padding: 1.15rem 1.35rem 1.15rem 1.15rem;
		background: rgba(255, 253, 247, 0.72);
		box-shadow: 0 0.8rem 2rem rgba(49, 88, 68, 0.04);
		transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
		animation: card-in 600ms both;
	}
	.event-card:hover {
		transform: translateY(-3px);
		border-color: rgba(49, 88, 68, 0.35);
		box-shadow: 0 1rem 2.5rem rgba(49, 88, 68, 0.1);
	}
	.date-container {
		align-self: stretch;
		display: flex;
		flex-direction: column;
		justify-content: center;
		border-radius: 0.75rem;
		padding: 0.9rem;
		color: var(--text-light);
		background: var(--primary);
	}
	.event-day, .event-type {
		margin: 0;
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.event-date {
		margin: 0.4rem 0 0;
		font: 500 1.45rem/0.95 "Fraunces", Georgia, serif;
	}
	.event-details { min-width: 0; }
	.event-type { color: var(--accent-dark); }
	.event-title {
		margin: 0.4rem 0 0.2rem;
		color: var(--primary);
		font: 500 clamp(1.25rem, 2vw, 1.65rem)/1.05 "Fraunces", Georgia, serif;
	}
	.event-venue {
		margin: 0;
		color: var(--text-dark);
		font-size: 0.82rem;
		font-weight: 600;
	}
	.event-city-state {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.78rem;
	}
	.event-actions { display: flex; flex-direction: column; gap: 0.45rem; align-items: flex-end; }
	.event-actions a {
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.event-actions a:hover { color: var(--accent-dark); }
	.event-actions span { color: var(--accent); }
	@keyframes card-in { from { opacity: 0; transform: translateY(0.8rem); } to { opacity: 1; transform: none; } }
	@media (max-width: 560px) {
		.event-card { grid-template-columns: 5.6rem 1fr; gap: 1rem; padding: 0.75rem; }
		.event-actions { grid-column: 2; flex-direction: row; justify-content: flex-start; }
		.date-container { padding: 0.7rem; }
	}
</style>
