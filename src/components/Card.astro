---
interface Props {
	eventPage: string;
	date: string;
	venueName: string;
	eventTitle: string;
	streetAddress: string;
	city: string;
	state: string;
	ticketLink: string;
	venueWebsite: string;
}

const {
	eventPage,
	date,
	venueName,
	streetAddress,
	city,
	state,
	ticketLink,
	venueWebsite,
	eventTitle,
} = Astro.props;

function getLocalizedDate(eventDate: string) {
	const date = new Date(eventDate);
	const timezoneOffset = date.getTimezoneOffset();
	date.setMinutes(date.getMinutes() + timezoneOffset);
	return date;
}

function getWeekdayName(eventDate: string) {
	const weekdayName = getLocalizedDate(eventDate).toLocaleDateString("en-US", {
		weekday: "long",
	});
	return weekdayName;
}

function getMonthAndDate(eventDate: string) {
	const monthAndDate = getLocalizedDate(eventDate).toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
	});
	return monthAndDate;
}
---

<li class="link-card my-8 flex flex-row p-6 rounded-md w-full text-white">
	<div class="date-container w-1/3 rounded-sm p-4 shadow-sm">
		<h3 class="event-day">{getWeekdayName(date)}</h3>
		<h2 class="event-date">{getMonthAndDate(date)}</h2>
	</div>
	<div class="event-details grow text-center">
		<h2 class="event-title font-bold">{eventTitle}</h2>
		<h4 class="event-venue">{venueName}<br /></h4>
		<p class="event-city-state">{city}, {state}</p>
		<a
			class="event-ticket-link hover:primary"
			href={ticketLink ? ticketLink : null}
			>{ticketLink ? `Tickets Available` : ``}</a
		>
		<a class="event-venue-website" href={venueWebsite ? venueWebsite : null}
			>{venueWebsite ? `Venue Website` : null}</a
		>
	</div>
</li>
<style>
	.link-card {
		list-style: none;
		background-color: #23262d;
		background-position: 100%;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
		text-decoration: none;
		line-height: 1.4;
		color: white;
		background-color: #23262d;
		opacity: 0.8;
	}
	.date-container {
		background-color: var(--primary);
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	p {
		margin-top: 0.5rem;
		margin-bottom: 0;
	}
	.event-details > a {
		text-decoration: underline;
	}
	.event-details > a:hover {
		color: var(--primary);
	}
</style>
