---
import { getMonthAndDate, getWeekdayName } from "../utils/date";

interface Props {
	date: string;
	venueName: string;
	eventTitle: string;
	city: string;
	state: string;
	ticketLink: string;
	venueWebsite: string;
}

const {
	date,
	venueName,
	city,
	state,
	ticketLink,
	venueWebsite,
	eventTitle,
} = Astro.props;

---

<li class="event-card">
	<div class="date-container">
		<p class="event-day">{getWeekdayName(date)}</p>
		<h2 class="event-date">{getMonthAndDate(date)}</h2>
	</div>
	<div class="event-details">
		<p class="eyebrow">Live event / {getWeekdayName(date)}</p>
		<h2 class="event-title">{eventTitle}</h2>
		<p class="event-venue">{venueName}</p>
		<p class="event-city-state">{city}{city && state ? ", " : ""}{state}</p>
	</div>
	<div class="event-actions">
		{ticketLink && <a href={ticketLink}>Tickets <span>↗</span></a>}
		{venueWebsite && <a href={venueWebsite}>Venue <span>↗</span></a>}
	</div>
</li>
<style>
	.event-card { position: relative; display: grid; grid-template-columns: 8rem 1fr auto; gap: 2rem; align-items: center; list-style: none; padding: 1.5rem 0; border-top: 1px solid var(--line); animation: rise 700ms both; }
	.event-card:last-child { border-bottom: 1px solid var(--line); }
	.date-container { display: flex; flex-direction: column; justify-content: center; min-height: 7rem; padding: 1rem; color: var(--ink); background: var(--acid); transform: rotate(-2deg); }
	.event-day { margin: 0 0 0.35rem; font-family: var(--mono); font-size: 0.65rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
	.event-date { margin: 0; font-family: var(--serif); font-size: 1.65rem; font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; }
	.event-details { min-width: 0; }
	.event-details .eyebrow { margin: 0 0 0.5rem; color: var(--coral); }
	.event-title { margin: 0; color: var(--paper); font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.06em; line-height: 0.95; }
	.event-venue { margin: 0.75rem 0 0; color: var(--paper); font-size: 0.85rem; font-weight: 600; }
	.event-city-state { margin: 0.2rem 0 0; color: var(--paper-muted); font-family: var(--mono); font-size: 0.65rem; text-transform: uppercase; }
	.event-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 0.55rem; }
	.event-actions a { color: var(--paper); font-family: var(--mono); font-size: 0.65rem; text-decoration: none; text-transform: uppercase; }
	.event-actions span { color: var(--acid); }
	.event-card:hover .event-title { color: var(--acid); }
	@keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
	@media (max-width: 620px) {
		.event-card { grid-template-columns: 5.5rem 1fr; gap: 1.25rem; }
		.date-container { min-height: 5.5rem; padding: 0.7rem; }
		.event-date { font-size: 1.25rem; }
		.event-actions { grid-column: 2; flex-direction: row; align-items: flex-start; }
	}
</style>
