---
import { getMonthAndDate, getWeekdayName } from "../utils/date";

interface Props {
	date: string; venueName: string; eventTitle: string; city: string; state: string;
	ticketLink: string; venueWebsite: string;
}
const { date, venueName, city, state, ticketLink, venueWebsite, eventTitle } = Astro.props;
---

<li class="event-card">
	<div class="date-container"><p class="event-day">{getWeekdayName(date)}</p><h2 class="event-date">{getMonthAndDate(date)}</h2></div>
	<div class="event-details">
		<p class="event-type">Live / Snoqualmie Valley</p>
		<h2 class="event-title">{eventTitle}</h2>
		<h4 class="event-venue">{venueName}</h4>
		<p class="event-city-state">{city}, {state}</p>
	</div>
	<div class="event-actions">
		{ticketLink && <a href={ticketLink}>Tickets <span>↗</span></a>}
		{venueWebsite && <a href={venueWebsite}>Venue <span>↗</span></a>}
	</div>
</li>

<style>
	.event-card { list-style: none; display: grid; grid-template-columns: 130px 1fr auto; align-items: center; gap: 1.5rem; margin: 1rem 0; padding: 1.2rem; border: 1px solid var(--line); background: var(--surface); color: var(--paper); position: relative; overflow: hidden; transition: transform .3s ease, border-color .3s ease, background .3s ease; }
	.event-card::after { content: ""; position: absolute; top: 0; right: 0; width: 7px; height: 100%; background: var(--signal); transform: scaleY(0); transform-origin: bottom; transition: transform .3s ease; }
	.event-card:hover { transform: translateX(6px); border-color: var(--signal); background: var(--surface-2); }
	.event-card:hover::after { transform: scaleY(1); }
	.date-container { border-right: 1px solid var(--line); padding: .4rem 1.25rem .4rem .4rem; }
	.event-day, .event-type { color: var(--signal); font: 500 .65rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
	.event-date { margin: .6rem 0 0; font: 600 clamp(1.65rem, 3vw, 2.5rem)/.85 var(--display); letter-spacing: -.03em; }
	.event-details { min-width: 0; }
	.event-type { margin: 0 0 .45rem; color: var(--muted); }
	.event-title { margin: 0; font: 600 clamp(1.4rem, 3vw, 2.2rem)/.95 var(--display); text-transform: uppercase; }
	.event-venue { margin: .6rem 0 0; font: 500 .8rem/1 var(--mono); text-transform: uppercase; }
	.event-city-state { margin: .35rem 0 0; color: var(--muted); font-size: .78rem; }
	.event-actions { display: flex; flex-direction: column; align-items: end; gap: .6rem; }
	.event-actions a { color: var(--paper); font: 500 .65rem/1 var(--mono); letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.event-actions a:hover { color: var(--signal); }
	.event-actions span { color: var(--signal); font-size: 1rem; }
	@media (max-width: 640px) { .event-card { grid-template-columns: 86px 1fr; gap: 1rem; } .date-container { padding-right: .75rem; } .event-actions { grid-column: 2; align-items: start; flex-direction: row; } }
</style>
