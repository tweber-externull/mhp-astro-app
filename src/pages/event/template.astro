<Layout title="Externull Events | Events">
	<img src="" srcset="" sizes="100vw" alt="" />
	<h1>An example event post</h1>
	<h2 class="event-date"></h2>
	<ul class="event-lineup">
		<li class="event-artist"></li>
		<li class="event-artist"></li>
	</ul>
	<p class="event-venue"></p>
	<a class="cta button"><h3>Get Tickets</h3></a>

	<p>
		<a href="/">&larr; back to all events</a>
	</p>
</Layout>

<style>
	* {
		color: var(--text-light);
	}
	.cta > * {
		color: var(--accent);
	}
</style>
