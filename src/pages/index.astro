---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { getEvents } from "../data/strapi";

const eventsData = await getEvents();

interface Event {
	id: number;
	event_name: string;
	start_date: string;
	// ticket_link?: string;
	// event_poster?: {
	// 	url: string;
	// };
	// event_days: EventDay[];
}

function isOutdated(date: string) {
	const today = new Date();
	const todayTimezoneOffset = today.getTimezoneOffset();
	today.setMinutes(today.getMinutes() + todayTimezoneOffset);

	const event_date = new Date(date);
	const eventTimezoneOffset = event_date.getTimezoneOffset();
	event_date.setMinutes(event_date.getMinutes() + eventTimezoneOffset);

	return today > event_date;
}

const sortEventsByDate = (events: Array<Event>) => {
	return events.filter(e => e?.start_date).sort((a, b) => {
		const aDate = new Date(a.start_date);
		const bDate = new Date(b.start_date);

		if (aDate < bDate) {
			return -1;
		} else if (aDate > bDate) {
			return 1;
		} else {
			return 0;
		}
	});
};
---

<Layout
	title="Morgan Henley Presents | Live Entertainment Booking and Promotions"
>
	<main class="container md:w-3/4 m-auto">
		<h1 class="title text-center text-gradient md:font-size-l">Upcoming Events</h1>
		{
			eventsData && eventsData.length > 0 ? (
				sortEventsByDate(eventsData).map((event: any) => {
					const venue = event.event_days?.[0]?.event_day_venues?.[0]?.venue;
					if (event.start_date && !isOutdated(event.start_date)) {
						return (
							<Card
								date={event.start_date}
								venueName={venue?.venue_name || 'TBA'}
								eventTitle={event.event_name}
								ticketLink={event.ticket_link || ''}
								city={venue?.city || ''}
								state={venue?.state || ''}
								venueWebsite={venue?.website || ''}
							/>
						);
					}
				})
			) : (
				<p class="text-center">No upcoming events found. Make sure Strapi is running and has published events.</p>
			)
		}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		max-width: calc(100% - 2rem);
		color: var(--text-light);
		font-size: 1rem;
		line-height: 1.0;
	}
	h1 {
		font-size: 2rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: var(--accent-gradient);
		background-size: 400%;
		background-position: 0%;
		color: var(--accent-light);
	}
	.title {
		margin-bottom: 2rem;
		border: 2px outset var(--accent-light);
		/* background: var(--accent-gradient); */
		padding: 1.5rem;
		border-radius: 8px;
	}
	.title code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.title strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
</style>
