---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Header from "../components/Header.astro";
import NavbarLink from "../components/NavbarLink.astro";
import { wpquery } from "../data/wordpress";
import { ScriptTarget, type ListFormat } from "typescript";
import type { Key } from "react";

const data = await wpquery({
	query: `
		query AllEvents {
			events {
				nodes {
				eventDetails {
					eventDate
					venue {
						nodes {
							... on Venue {
							id
							venueDetails {
								name
								city
								state
								website
							}
							}
						}
					}
					ticketLink
					eventname
				}
				eventId
				id
				title
				}
			}
		}
	`,
});

interface Event {
	eventDetails: EventDetails;
	eventId: Int16Array;
	id: string;
	title: string;
}

interface EventDetails {
	eventDate: Date;
	venue: object;
	ticketLink: string;
	eventname: string;
}

function isOutdated(date: string) {
	const today = new Date();
	const todayTimezoneOffset = today.getTimezoneOffset();
	today.setMinutes(today.getMinutes() + todayTimezoneOffset);

	const eventDate = new Date(date);
	const eventTimezoneOffset = eventDate.getTimezoneOffset();
	eventDate.setMinutes(eventDate.getMinutes() + eventTimezoneOffset);

	return today > eventDate;
}

const sortEventsByDate = (events: Array<Event>) => {
	events.sort((a, b) => {
		const aDate = new Date(a.eventDetails.eventDate);
		const bDate = new Date(b.eventDetails.eventDate);

		if (aDate < bDate) {
			return -1;
		} else if (aDate > bDate) {
			return 1;
		} else {
			return 0;
		}
	});
	return events;
};
---

<Layout
	title="Morgan Henley Presents | Live Entertainment Booking and Promotions"
>
	<main>
		<h1 class="title text-center text-gradient md:font-size-l">Upcoming Events</h1>
		{
			sortEventsByDate(data.events.nodes).map((event: any) => {
				if (!isOutdated(event.eventDetails.eventDate)) {
					return (
						<Card
							eventPage={`/pages/event/${event.eventId}`}
							date={event.eventDetails.eventDate}
							venueName={event.eventDetails.venue.nodes[0].venueDetails.name}
							eventTitle={event.title}
							ticketLink={event.eventDetails.ticketLink}
							streetAddress={
								event.eventDetails.venue.nodes[0].venueDetails.address
							}
							city={event.eventDetails.venue.nodes[0].venueDetails.city}
							state={event.eventDetails.venue.nodes[0].venueDetails.state}
							venueWebsite={
								event.eventDetails.venue.nodes[0].venueDetails.website
							}
						/>
					);
				}
			})
		}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: var(--text-light);
		font-size: 1rem;
		line-height: 1.0;
	}
	h1 {
		font-size: 2rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: var(--accent-gradient);
		background-size: 400%;
		background-position: 0%;
		color: var(--accent-light);
	}
	.title {
		margin-bottom: 2rem;
		border: 2px outset var(--accent-light);
		/* background: var(--accent-gradient); */
		padding: 1.5rem;
		border-radius: 8px;
	}
	.title code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.title strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
</style>
