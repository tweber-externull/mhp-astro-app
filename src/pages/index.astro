---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { getEvents } from "../data/strapi";
import { isOutdated, sortEventsByDate } from "../utils/events";
const eventsData = await getEvents();
const upcomingEvents = sortEventsByDate(eventsData || []).filter((event: any) => event.start_date && !isOutdated(event.start_date));
---
<Layout title="Morgan Henley Presents | Live Entertainment Booking and Promotions">
	<main class="home">
		<section class="hero">
			<div class="hero-index">MHP / 2026 PROGRAM</div>
			<div class="hero-copy">
				<p class="kicker">Live music / community / the valley</p>
				<h1>Make<br /><span>some</span><br />noise.</h1>
				<p class="lede">Independent event production for the places where a good night becomes local history.</p>
				<a class="hero-link" href="#upcoming">Scan upcoming shows <span>↓</span></a>
			</div>
			<div class="hero-stamp" aria-hidden="true"><span>EST.</span><strong>2016</strong><span>WA / USA</span></div>
		</section>
		<section class="events-section" id="upcoming">
			<div class="section-heading"><div><p class="kicker">01 / On the calendar</p><h2>Upcoming<br /><em>events</em></h2></div><p class="section-note">Doors open. Stories start.<br />See you out there.</p></div>
			{upcomingEvents.length > 0 ? <ul class="events-list">{upcomingEvents.map((event: any) => {
				const venue = event.event_days?.[0]?.event_day_venues?.[0]?.venue;
				return <Card date={event.start_date} venueName={venue?.venue_name || "TBA"} eventTitle={event.event_name} ticketLink={event.ticket_link || ""} city={venue?.city || ""} state={venue?.state || ""} venueWebsite={venue?.website || ""} />;
			})}</ul> : <div class="empty"><p class="kicker">No signals detected</p><h3>Nothing on the calendar yet.</h3><p>Check back soon for the next MHP event.</p></div>}
		</section>
	</main>
</Layout>
<style>
	.home { width: min(1200px, calc(100% - 3rem)); margin: auto; }
	.hero { min-height: min(720px, calc(100vh - 86px)); display: grid; grid-template-columns: 1fr 3fr 1fr; align-items: center; gap: 2rem; padding: 5rem 0 7rem; border-bottom: 1px solid var(--line); position: relative; }
	.hero::before { content: ""; position: absolute; left: 15%; bottom: -1px; width: 35%; height: 5px; background: var(--signal); }
	.hero-index, .kicker, .hero-link { font: 500 .68rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
	.hero-index { align-self: start; padding-top: 1rem; color: var(--signal); writing-mode: vertical-rl; transform: rotate(180deg); }
	.hero-copy { animation: reveal .8s ease both; }
	.kicker { margin: 0; color: var(--signal); }
	h1 { margin: 1.2rem 0 2rem; font: 600 clamp(6rem, 15vw, 12rem)/.74 var(--display); letter-spacing: -.07em; text-transform: uppercase; }
	h1 span { color: var(--signal); font-style: italic; }
	.lede { max-width: 25rem; margin: 0 0 2rem 8%; color: var(--muted); font-size: 1rem; line-height: 1.5; }
	.hero-link { color: var(--paper); text-decoration: none; margin-left: 8%; }
	.hero-link span { color: var(--signal); font-size: 1.1rem; margin-left: .5rem; }
	.hero-link:hover { color: var(--signal); }
	.hero-stamp { justify-self: end; display: grid; gap: .35rem; width: 7rem; height: 7rem; place-content: center; border: 1px solid var(--signal); border-radius: 50%; color: var(--signal); text-align: center; transform: rotate(12deg); }
	.hero-stamp span { font: 500 .52rem/1 var(--mono); letter-spacing: .1em; }
	.hero-stamp strong { font: 600 2rem/.8 var(--display); }
	.events-section { padding: 7rem 0 2rem; }
	.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.5rem; }
	.section-heading h2 { margin: .8rem 0 0; font: 600 clamp(3.5rem, 9vw, 7rem)/.75 var(--display); letter-spacing: -.06em; text-transform: uppercase; }
	.section-heading em { color: var(--signal); font-style: italic; font-weight: 400; }
	.section-note { color: var(--muted); font: 500 .7rem/1.5 var(--mono); letter-spacing: .05em; text-align: right; text-transform: uppercase; }
	.events-list { padding: 0; margin: 0; }
	.empty { border: 1px dashed var(--line); padding: 4rem 2rem; text-align: center; }
	.empty h3 { margin: 1rem 0 .5rem; font: 500 2rem var(--display); text-transform: uppercase; }
	.empty p:last-child { color: var(--muted); }
	@keyframes reveal { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
	@media (max-width: 700px) { .home { width: calc(100% - 2rem); } .hero { min-height: auto; grid-template-columns: 1fr auto; padding: 4rem 0 5rem; } .hero-index { display: none; } .hero-copy { grid-column: 1 / -1; } .hero-stamp { grid-column: 2; grid-row: 1; width: 5.5rem; height: 5.5rem; } .lede, .hero-link { margin-left: 0; } .section-heading { align-items: start; flex-direction: column; } .section-note { text-align: left; } }
</style>
