---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Header from '../components/Header.astro';
import NavbarLink from '../components/NavbarLink.astro';
import { wpquery } from '../data/wordpress';

const data = await wpquery({
	query: `
		query AllEvents {
			events(where: {orderby: {field: DATE, order: DESC}}) {
				edges {
					node {
						id
						eventData {
							eventDate
							eventName
							venue {
								nodes {
									... on Venue {
										id
										venueData {
											name
											address
										}
									}
								}
							}
						}
						eventId
						title
					}
				}
			}
		}
	`,
});

---

<Layout title="Externull Events">
	<main>
		<h1>Welcome to <span class="text-gradient">Externull Events</span></h1>
		<p class="instructions text-center">Upcoming Events</p>
		{data.events.edges.map((event: any) => {
			console.log(event.node.eventData.venue.nodes[0].venueData.address)
			return (
				<Card
					eventPage={`/pages/event/${event.node.eventId}`}
					date={event.node.eventData.eventDate}
					venueName={event.node.eventData.venue.nodes[0].venueData.name}
					eventTitle={event.node.title}
					address={event.node.eventData.venue.nodes[0].venueData.address}
				/>
			)
		})}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: var(--text-light);
		font-size: 20px;
		line-height: 1.6;
	}
	.astro-a {
		position: absolute;
		top: -32px;
		left: 50%;
		transform: translatex(-50%);
		width: 220px;
		height: auto;
		z-index: -1;
	}
	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
	.instructions code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.instructions strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
</style>
